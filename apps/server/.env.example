GO_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
DATABASE_URL_REPLICA=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=localhost:6379
REDIS_TTL_SECONDS=3600

# Kafka
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8082
KAFKA_BROKERS=kafka:9092
