# Server config
AI_SERVER_PORT=8080

# Kafka connection (use private IP of Kafka EC2 instance)
KAFKA_BROKERS=10.0.1.100:9092
KAFKA_CONSUMER_GROUP_ID=ai-server-language-detection

# Topics
KAFKA_TOPIC_CONSUME=message.created
KAFKA_TOPIC_PRODUCE=message.language-detected

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Redis (ElastiCache endpoint)
REDIS_URL=your-elasticache-endpoint.cache.amazonaws.com:6379
REDIS_PASSWORD=
